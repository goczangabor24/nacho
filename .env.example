# Copy to .env for local development. The real .env is git-ignored.

# Host port 5433 because Homebrew Postgres owns 5432 on this machine; inside
# the compose network the database is simply "db:5432".
DATABASE_URL=postgres://nacho:nacho@localhost:5433/nacho?sslmode=disable

# Local default; Render and other hosts set this themselves.
PORT=8080
